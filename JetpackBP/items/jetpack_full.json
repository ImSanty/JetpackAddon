{
  "format_version": "1.16.100",
  "minecraft:item": {
    "description": {
      "identifier": "is:jetpack",
      "category": "equipment"
    },
    "components": {
      "minecraft:max_stack_size": 1,
      "minecraft:armor": {
        "protection": 6
      },
      "minecraft:wearable": {
        "slot": "slot.armor.chest"
      },
      "minecraft:icon": {
        "texture": "jetpack_full"
      },
      "minecraft:creative_category": {
        "parent": "itemGroup.name.a"
      }
    },
    "events": {
      "is:power_mode": {
        "sequence": [
          {
            "condition": "query.is_sneaking && query.scoreboard('power_mode') == 0",
            "run_command": {
              "command": [
                "function test1",
                "title @s actionbar §l§aPower Mode: §rTurbo"
              ],
              "target": "holder"
            }
          },
          {
            "condition": "query.is_sneaking && query.scoreboard('power_mode') == 1",
            "run_command": {
              "command": [
                "function test2",
                "title @s actionbar §l§aPower Mode: §rStandar"
              ],
              "target": "holder"
            }
          }
        ]
      }
    }
  }
}